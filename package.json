{
  "name": "pokepixel-hunt-analyzer",
  "version": "1.9.1",
  "private": true,
  "description": "Local domain/persistence modules and Tampermonkey build for the PokePixel Hunt Analyzer.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "build:userscript": "node scripts/build-userscript.mjs",
    "build:userscript:dev": "node scripts/build-userscript.mjs --dev",
    "audit:deps": "npm audit --audit-level=high",
    "validate": "npm test && npm run build:userscript"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leojlsv/pokepixel-hunt-analyzer.git"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
