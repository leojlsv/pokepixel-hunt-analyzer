{
  "manifest_version": 3,
  "name": "PokePixel Capture Counter",
  "version": "1.0.0",
  "description": "Tracks PokePixel Hunt encounters, captures, and efficiency in a side panel — passive observation only, no raw data stored.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://pokepixel.nietore.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open/close PokePixel Capture Counter"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "windows": "Ctrl+Shift+7"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokepixel.nietore.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokepixel.nietore.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}